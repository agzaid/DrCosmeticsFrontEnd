{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:api": "dotnet run --project ../backend/src/LumaBeauty.Api --launch-profile https",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "npm run typecheck && npm run typecheck:e2e",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
