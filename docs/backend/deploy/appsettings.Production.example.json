{
  "ConnectionStrings": {
    "Default": "Server=<sql-host>;Database=LumaBeauty;Trusted_Connection=True;Encrypt=True"
  },
  "AllowedHosts": "<shop.example.com>",
  "DataProtection": {
    "KeysPath": "<D:\\LumaBeauty\\data\\keys>",
    "CertificateThumbprint": ""
  },
  "FileStorage": {
    "RootPath": "<D:\\LumaBeauty\\data\\storage>",
    "ImagesFolder": "images",
    "DocumentsFolder": "documents",
    "PublicBasePath": "/media"
  },
  "Pricing": {
    "QuoteLifetimeMinutes": 15
  },
  "Checkout": {
    "ReservationTimeoutSeconds": 120,
    "LockTimeoutSeconds": 10
  },
  "Retention": {
    "Enabled": true,
    "IdempotencyDays": 30,
    "AbandonedReservationDays": 1,
    "GuestSessionGraceDays": 7,
    "IntervalMinutes": 360,
    "BatchSize": 1000
  },
  "RateLimits": {
    "AuthPermitLimit": 10,
    "CheckoutPermitLimit": 5
  },
  "Email": {
    "FromAddress": "",
    "FromName": "Luma Beauty",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Security": "StartTls",
      "UserName": "",
      "Password": ""
    }
  },
  "PasswordReset": {
    "LinkBaseUrl": "",
    "TokenLifetimeMinutes": 60
  },
  "Scraper": {
    "UserAgent": "LumaBeautyPriceCheck/1.0 (price comparison for this shop)",
    "TimeoutSeconds": 20,
    "MaxPageKilobytes": 4096,
    "Browser": {
      "Enabled": true,
      "ExecutablePath": "",
      "TimeoutSeconds": 45,
      "NoSandbox": false
    }
  },
  "Hosting": {
    "RedirectToHttps": true,
    "HstsMaxAgeDays": 30
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": []
  },
  "OpenApi": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Critical"
    }
  }
}
