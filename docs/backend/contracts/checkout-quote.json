  "rules": {
    "subtotal": "sum(round2(unitPrice * quantity)) using current variant prices",
    "discountPercentage": "min(subtotal * value / 100, maxDiscount) when set",
    "discountFixed": "min(value, subtotal)",
    "couponEligibility": "active AND now < expiryDate AND (usageLimit = 0 OR currentUsage < usageLimit) AND subtotal >= minOrderAmount",
    "deliveryFee": "subtotal = 0 → 0 ; subtotal >= 600 → 0 ; otherwise 50",
    "amountNeededForFreeDelivery": "subtotal = 0 → 600 ; otherwise max(0, 600 - subtotal)",
    "total": "max(0, subtotal - discountAmount + deliveryFee)",
    "rounding": "decimal, MidpointRounding.AwayFromZero, 2 dp"
  }
