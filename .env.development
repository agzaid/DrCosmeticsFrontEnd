# Address of the LumaBeauty API while developing. This is the one place to change it (read by src/api/config.ts and
# vite.config.ts). A shell variable of the same name overrides it.
#
# `npm run dev` keeps the browser on the Vite origin and forwards /api and /media to this address, so the HttpOnly
# SameSite=Lax cookies stay first-party and no CORS is needed. Visual Studio's "https" launch profile and
# `npm run dev:api` both listen here; Swagger is <this address>/swagger.
VITE_API_URL=https://localhost:7108
